{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.openai.com/**"
        },
        {
          "url": "https://openrouter.ai/**"
        },
        {
          "url": "https://generativelanguage.googleapis.com/**"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    }
  ]
}